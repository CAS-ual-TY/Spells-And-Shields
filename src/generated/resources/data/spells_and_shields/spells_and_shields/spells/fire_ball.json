{
  "s1/title": {
    "translate": "spell.spells_and_shields.fire_ball"
  },
  "s2/icon": {
    "type": "spells_and_shields:default",
    "texture": "spells_and_shields:textures/spell/fire_ball.png"
  },
  "s3/mana_cost": 5.0,
  "s4/tooltip": [
    {
      "translate": "spell.spells_and_shields.fire_ball.desc"
    },
    "",
    {
      "color": "blue",
      "translate": "spell.generic.title.item_cost.hand"
    },
    {
      "color": "yellow",
      "translate": "spell.generic.item_cost.single",
      "with": [
        {
          "translate": "item.minecraft.blaze_powder"
        }
      ]
    }
  ],
  "s5/spell_events": {
    "active": "active"
  },
  "s6/spell_parameters": [
    {
      "type": "spells_and_shields:double",
      "value": 2.5,
      "var/name": "speed"
    },
    {
      "type": "spells_and_shields:int",
      "value": 2,
      "var/name": "fire_seconds"
    },
    {
      "type": "spells_and_shields:string",
      "value": "minecraft:blaze_powder",
      "var/name": "item"
    }
  ],
  "s7/spell_actions": [
    {
      "type": "spells_and_shields:call_function",
      "activation": "active",
      "function": "spells_and_shields:check_mana_and_item_cost"
    },
    {
      "type": "spells_and_shields:activate",
      "a/to_activate": "shoot",
      "activation": "active"
    },
    {
      "type": "spells_and_shields:shoot",
      "activation": "shoot",
      "ad/block_hit_activation": "on_block_hit",
      "ad/entity_hit_activation": "on_entity_hit",
      "ad/timeout_activation": "on_timeout",
      "d/double/inaccuracy": 0.0,
      "d/double/velocity": "<<speed>>",
      "d/int/timeout": 200,
      "t/source": "owner",
      "td/projectile": "projectile"
    },
    {
      "type": "spells_and_shields:activate",
      "a/to_activate": "animation",
      "activation": "shoot"
    },
    {
      "type": "spells_and_shields:put_string",
      "activation": "animation",
      "d/string/source": "<< uuid_from_string('_animation_stab') >>",
      "var/result": "animation_uuid"
    },
    {
      "type": "spells_and_shields:activate",
      "a/to_activate": "animation_offhand",
      "activation": "animation"
    },
    {
      "type": "spells_and_shields:check_has_delayed_spell",
      "activation": "animation_offhand",
      "d/string/uuid": "<<animation_uuid>>",
      "t/target": "owner"
    },
    {
      "type": "spells_and_shields:deactivate",
      "a/to_deactivate": "animation",
      "activation": "animation_offhand"
    },
    {
      "type": "spells_and_shields:add_delayed_spell",
      "activation": "animation",
      "ad/on_remove": "",
      "d/compound_tag/extra_data": {},
      "d/int/tick_time": 20,
      "d/string/uuid": "<<animation_uuid>>",
      "ts/targets": "owner"
    },
    {
      "type": "spells_and_shields:remove_delayed_spell",
      "activation": "animation_offhand",
      "d/boolean/force_activate": false,
      "d/string/uuid": "<<animation_uuid>>",
      "ts/targets": "owner"
    },
    {
      "type": "spells_and_shields:play_animation",
      "activation": "animation",
      "d/string/first_person_animation": "spells_and_shields:stab_1p",
      "d/string/third_person_animation": "spells_and_shields:stab",
      "ts/targets": "owner"
    },
    {
      "type": "spells_and_shields:play_animation",
      "activation": "animation_offhand",
      "d/string/first_person_animation": "spells_and_shields:stab_1p_off",
      "d/string/third_person_animation": "spells_and_shields:stab_off",
      "ts/targets": "owner"
    },
    {
      "type": "spells_and_shields:play_sound",
      "activation": "shoot",
      "d/double/pitch": 1.0,
      "d/double/volume": 1.0,
      "d/string/sound_event": "minecraft:entity.blaze.shoot",
      "ts/targets": "owner"
    },
    {
      "type": "spells_and_shields:put_int",
      "activation": "shoot",
      "d/int/source": 18,
      "var/result": "particle_amount"
    },
    {
      "type": "spells_and_shields:put_double",
      "activation": "shoot",
      "d/double/source": 2.0,
      "var/result": "particle_radius"
    },
    {
      "type": "spells_and_shields:custom_particle_emitter_position",
      "activation": "shoot",
      "captured_variables": [
        "particle_amount",
        "particle_radius"
      ],
      "d/int/count": "<<particle_amount>>",
      "d/int/delay": 0,
      "d/int/period": 0,
      "d/int/total_lifetime": 300,
      "p1/position": "vec3(sin(to_radians(age * 10 + index * (360/particle_amount))) * 0.00015,sin(to_radians(age * particle_amount + index * (360/particle_amount))) * particle_radius,cos(to_radians(age * particle_amount + index * (360/particle_amount))) * particle_radius)",
      "p2/color": "vec3(1.0, 0.0, 0.05)",
      "p3/alpha": "1.0 - age / to_double(max_age)",
      "position_attach_mode": "relative",
      "rotation_attach_mode": "relative",
      "ts/targets": "projectile"
    },
    {
      "type": "spells_and_shields:custom_particle_emitter_position",
      "activation": "shoot",
      "captured_variables": [
        "particle_amount",
        "particle_radius"
      ],
      "d/int/count": "<<particle_amount>>",
      "d/int/delay": 0,
      "d/int/period": 0,
      "d/int/total_lifetime": 300,
      "p1/position": "vec3(sin(to_radians(age * particle_amount + index * (360/particle_amount))) * particle_radius,sin(to_radians(age * 10 + index * (360/particle_amount))) * 0.00015,cos(to_radians(age * particle_amount + index * (360/particle_amount))) * particle_radius)",
      "p2/color": "vec3(1.0, 0.5, 0.05)",
      "p3/alpha": "1.0 - age / to_double(max_age)",
      "position_attach_mode": "relative",
      "rotation_attach_mode": "relative",
      "ts/targets": "projectile"
    },
    {
      "type": "spells_and_shields:custom_particle_emitter_position",
      "activation": "shoot",
      "captured_variables": [
        "particle_amount",
        "particle_radius"
      ],
      "d/int/count": "<<particle_amount>>",
      "d/int/delay": 0,
      "d/int/period": 0,
      "d/int/total_lifetime": 300,
      "p1/position": "vec3(sin(to_radians(age * particle_amount + index * (360/particle_amount))) * particle_radius,cos(to_radians(age * particle_amount + index * (360/particle_amount))) * particle_radius,sin(to_radians(age * 10 + index * (360/particle_amount))) * 0.00015)",
      "p2/color": "vec3(1.0, 1.0, 0.05)",
      "p3/alpha": "1.0 - age / to_double(max_age)",
      "position_attach_mode": "relative",
      "rotation_attach_mode": "relative",
      "ts/targets": "projectile"
    },
    {
      "type": "spells_and_shields:boolean_activation",
      "a/to_activate": "no_pvp",
      "activation": "on_entity_hit",
      "d/boolean/activate_if_true": true,
      "d/boolean/deactivate_if_false": false,
      "d/boolean/input": "<< !pvp() >>"
    },
    {
      "type": "spells_and_shields:filter_player_targets",
      "activation": "no_pvp",
      "d/boolean/move": true,
      "td/destination": "",
      "ts/source": "entity_hit"
    },
    {
      "type": "spells_and_shields:sourced_damage",
      "activation": "on_entity_hit",
      "d/double/damage": 2.0,
      "t/source": "projectile",
      "ts/targets": "entity_hit"
    },
    {
      "type": "spells_and_shields:set_on_fire",
      "activation": "on_entity_hit",
      "d/int/fire_seconds": "<<fire_seconds>>",
      "ts/targets": "entity_hit"
    },
    {
      "type": "spells_and_shields:activate",
      "a/to_activate": "fx",
      "activation": "on_entity_hit"
    },
    {
      "type": "spells_and_shields:activate",
      "a/to_activate": "fx",
      "activation": "on_block_hit"
    },
    {
      "type": "spells_and_shields:activate",
      "a/to_activate": "fx",
      "activation": "on_timeout"
    },
    {
      "type": "spells_and_shields:play_sound",
      "activation": "fx",
      "d/double/pitch": 1.0,
      "d/double/volume": 1.0,
      "d/string/sound_event": "minecraft:entity.blaze.shoot",
      "ts/targets": "hit_position"
    },
    {
      "type": "spells_and_shields:spawn_particles",
      "activation": "fx",
      "d/double/spread": 0.2,
      "d/int/count": 3,
      "particle": {
        "type": "minecraft:large_smoke"
      },
      "ts/targets": "hit_position"
    },
    {
      "type": "spells_and_shields:spawn_particles",
      "activation": "fx",
      "d/double/spread": 0.2,
      "d/int/count": 1,
      "particle": {
        "type": "minecraft:lava"
      },
      "ts/targets": "hit_position"
    },
    {
      "type": "spells_and_shields:spawn_particles",
      "activation": "fx",
      "d/double/spread": 0.1,
      "d/int/count": 2,
      "particle": {
        "type": "minecraft:smoke"
      },
      "ts/targets": "hit_position"
    },
    {
      "type": "spells_and_shields:spawn_particles",
      "activation": "fx",
      "d/double/spread": 0.1,
      "d/int/count": 2,
      "particle": {
        "type": "minecraft:flame"
      },
      "ts/targets": "hit_position"
    }
  ]
}