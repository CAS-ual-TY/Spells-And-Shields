{
  "f1/parameters": [
    {
      "type": "spells_and_shields:int",
      "value": 100,
      "var/name": "duration"
    }
  ],
  "f2/map_activations": {
    "active": "_active"
  },
  "f3/map_variables": {
    "mana_cost": "_mana_cost"
  },
  "f4/map_targets": {
    "owner": "_owner"
  },
  "f5/actions": [
    {
      "type": "spells_and_shields:has_mana",
      "activation": "_active",
      "d/double/amount": "<<_mana_cost>>",
      "t/target": "_owner"
    },
    {
      "type": "spells_and_shields:has_cooldown",
      "activation": "_active",
      "d/int/slot": "<<spell_slot>>",
      "t/source": "_owner"
    },
    {
      "type": "spells_and_shields:burn_mana",
      "activation": "_active",
      "d/double/amount": "<<_mana_cost>>",
      "ts/targets": "_owner"
    },
    {
      "type": "spells_and_shields:set_cooldown",
      "activation": "_active",
      "d/int/duration": "<<duration>>",
      "d/int/slot": "<<spell_slot>>",
      "t/target": "_owner"
    }
  ]
}